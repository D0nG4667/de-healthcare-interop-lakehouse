# ==============================================================================
# HIPAA / CLINICAL PHI PROTECTION & KMS CREDENTIAL SAFEGUARDS
# Strictly block raw clinical feeds, patient CSV exports, HL7v2 messages,
# unmasked FHIR payloads, and local AWS KMS / cryptographic key material.
# ==============================================================================
*.csv
*.hl7
*.mllp
*.fhir.json
*.fhir.xml
*.parquet

# Local Lakehouse Data Zones (Bronze / Silver / Gold)
data/*
!data/.gitkeep
lakehouse_data/*

